DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5433/vectordb
REDIS_URL=redis://localhost:6379/0
APP_BASE_URL=http://localhost:8000

SLACK__SIGNING_SECRET=slack-signing-secret
SLACK__CLIENT_ID=slack-client-id
SLACK__CLIENT_SECRET=slack-client-secret
SLACK__BOT_TOKEN=slack-bot-token

LLM__PROVIDER__API_KEY=openrouter-api-key

# Whether runs propose mitigation options at all
MITIGATION__ENABLED=true
# Cap on options per run; more than a handful is a menu, not a recommendation.
MITIGATION__MAX_OPTIONS=3

# `synthetic` reads scenario fixtures; `real` talks to the backends below.
TOOLS__PROVIDER=synthetic
TOOLS__HTTP_TIMEOUT_S=5.0
TOOLS__PROMETHEUS__BASE_URL=http://localhost:9090
TOOLS__PROMETHEUS__QUERY_SET=default
TOOLS__LOKI__BASE_URL=http://localhost:3100

TOOLS__GITHUB__REPO=acme/checkout
TOOLS__GITHUB__TOKEN=github_pat_read_only
TOOLS__UNLEASH__BASE_URL=http://localhost:4242
TOOLS__UNLEASH__TOKEN=default:development.flare-local-read-token